{
  "$schema": "https://bioassembly.github.io/hybrid-sage/fleet.schema.json",
  "description": "Three-harness fleet: OpenCode model workers, Antigravity frontier consultation, and Codex independent review. Provider billing and locality must be checked; local CLI execution does not imply local inference.",
  "default_unit": "free-workhorse",
  "shared_bridges": {
    "memory_file": "~/.config/opencode/memory.json",
    "lessons_file": "~/.config/opencode/lessons.jsonl",
    "stats_file": "~/.config/opencode/hybrid-sage-stats.jsonl",
    "handoff_file": "NOTES.md"
  },
  "units": [
    {
      "id": "local-workhorse",
      "role": "Workhorse (Privacy, High-Volume Loops, TDD, Boilerplate & Local Review)",
      "model": "OpenCode Active Local Model (e.g. Qwen 3.8 Flash Next)",
      "model_id": "opencode-default",
      "harness": "OpenCode CLI (`opencode`) / Native MCP (`delegate_local`)",
      "endpoint": "opencode://cli",
      "locality": "local",
      "privacy_cleared": true,
      "max_context": 262144,
      "resident_kv": 131072,
      "cost_weight": 0,
      "enabled": true,
      "tags": [
        "privacy",
        "loop",
        "tdd",
        "boilerplate",
        "batch",
        "vision",
        "default"
      ],
      "command_template": "delegate_local(prompt={prompt}, require_local=True)"
    },
    {
      "id": "cloud-sprinter",
      "role": "Sprinter (Interactive Multi-File, Live Web Search, Subagents & Fast Triage)",
      "model": "Gemini 3.8 Flash (Antigravity Cloud)",
      "model_id": "gemini-3.8-flash-medium",
      "harness": "Antigravity CLI (`agy --mode plan`)",
      "endpoint": "agy://cloud-sprinter",
      "locality": "cloud",
      "privacy_cleared": false,
      "max_context": 1000000,
      "cost_weight": 1,
      "enabled": true,
      "tags": [
        "web",
        "subagents",
        "interactive",
        "review",
        "long-context"
      ],
      "command_template": "escalate_task(prompt={prompt}, target_model='gemini-3.8-flash-medium')"
    },
    {
      "id": "frontier-architect",
      "role": "Architect (System Design, Adversarial Red-Team, Security Audit & 2-Strike Escalation)",
      "model": "Gemini 4 Argon (Antigravity Frontier)",
      "model_id": "gemini-4-argon-medium",
      "harness": "Antigravity CLI (`agy --mode plan`)",
      "endpoint": "agy://frontier-architect",
      "locality": "cloud",
      "privacy_cleared": false,
      "max_context": 1000000,
      "cost_weight": 3,
      "enabled": true,
      "tags": [
        "architecture",
        "red-team",
        "security",
        "deep-debug",
        "long-context"
      ],
      "command_template": "escalate_task(prompt={prompt}, target_model='gemini-4-argon-medium')"
    },
    {
      "id": "codex-specialist",
      "role": "Independent code review and design diagnosis via Codex",
      "model": "Codex default (or explicit model_id)",
      "model_id": "codex-default",
      "harness": "Codex CLI",
      "endpoint": "codex://cli",
      "locality": "cloud",
      "privacy_cleared": false,
      "max_context": 128000,
      "cost_weight": 3,
      "enabled": true,
      "tags": [
        "codex",
        "architecture",
        "review"
      ],
      "command_template": "consult_codex(prompt={prompt})"
    },
    {
      "id": "free-workhorse",
      "role": "Free-model implementation and test worker via OpenCode",
      "model": "Operator-approved free OpenCode worker",
      "model_id": "opencode/glm-5.3-flash-free",
      "harness": "OpenCode CLI",
      "endpoint": "opencode://free",
      "locality": "cloud",
      "privacy_cleared": false,
      "max_context": 200000,
      "cost_weight": 0,
      "enabled": true,
      "tags": [
        "loop",
        "boilerplate",
        "batch",
        "tdd",
        "default"
      ],
      "command_template": "delegate_local(prompt={prompt}, free_only=True)"
    }
  ],
  "worker_policy": {
    "default_model": "opencode/glm-5.3-flash-free",
    "free_model_ids": [
      "opencode/glm-5.3-flash-free",
      "opencode/mimo-v2.6-flash-free",
      "opencode/nemotron-3.5-lightning-free",
      "opencode/nemotron-3.5-super-vl-free",
      "opencode/deepseek-v4.1-flash-free"
    ],
    "max_parallel_jobs": 3,
    "timeout_sec": 900
  }
}
